{
	"name": "site",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo '' && husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check ."
	},
	"devDependencies": {
		"@iconify-json/material-symbols": "^1.2.96",
		"@iconify-json/mdi": "^1.2.3",
		"@iconify-json/simple-icons": "^1.2.100",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"unplugin-icons": "^24.0.0",
		"vite": "^8.3.5"
	},
	"dependencies": {
		"results-ts": "^4.4.0",
		"zod": "^4.6.7"
	},
	"imports": {
		"#lib/*": "./src/lib/*",
		"#components/*": "./src/lib/components/*",
		"#assets/*": "./src/assets/*"
	},
	"lint-staged": {
		"*": "prettier --write --ignore-unknown"
	}
}
